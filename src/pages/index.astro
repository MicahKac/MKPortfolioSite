---
import Header from "../components/Header.astro";
import '../styles/home.css';
import { Image } from 'astro:assets';
import Introimage from '../assets/Micah_0035.jpg';
import Projectsimage from '../assets/Projectbanner.jpg'
import Photosimage from '../assets/IMG_5099adj.jpg'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Micah Kacmarynski</title>

	</head>
	<body>

		<div class="container">
			<Header />
			<div id="homepage-content">
				<div id="intro-container">	
					<Image class="border" id="intro-image" src={Introimage} alt="A man" />
					<div class="border" id="intro-paragraph">
						<p>Hi, I'm Micah K.
This site lets you check out some of my personal hobby projects, as well as some larger work I've done.
You can also find some of my other information here.</p>
					</div>
				</div>
				<div id="card-container">
					<a href="/src/pages/projects" id="projects-card" class="cards">
						<h2 id="projects-card-title">Projects</h2>
						<Image id="projects-card-image" src={Projectsimage} alt="a manual lathe with a part loaded between centers" />
					</a>
					<a href="/src/pages/photos" id="photos-card" class="cards">
						<h2 id="photos-card-title">Photos</h2>
						<Image id="photos-card-image" src={Photosimage} alt="a redwing blackbird flying against a grass background"/>
					</a>
					<a href="/src/pages/about" id="about-card" class="cards">
						<h2>About</h2>
					</a>
					<a href="/src/pages/contact" id="contact-card" class="cards">
						<h2>Contact</h2>
					</a>
				</div>
				<h6>© 2026 Micah Kacmarynski. All Rights Reserved.</h6>
			</div>
			
		</div>

	</body>
</html>
