---
import Header from "../components/Header.astro";
import '../styles/home.css';
import { Image } from 'astro:assets';
import Introimage from '../assets/Micah_0035.jpg';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Micah Kacmarynski</title>

	</head>
	<body>
	<Header />
		<div class="container">
			<div id="homepage-content">
				<div id="intro-container">	
					<Image class="border" id="intro-image" src={Introimage} alt="A photo of a man" />
					<div class="border" id="intro-paragraph">
						<p>Hey, I'm Micah K.
This site lets you check out some of my personal hobby projects, as well as some larger work I've done.
You can also find some of my other information here.</p>
					</div>
				</div>
				<div id="link-container">

				</div>

			</div>

		</div>
	</body>
</html>
