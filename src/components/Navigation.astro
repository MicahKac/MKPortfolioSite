---
import '../styles/global.css';
---

<head>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Exo+2|Exo|Audiowide|Orbitron|Roboto">
	<body>
		<div class="navigation-bar" id="nav-bg">
			<a href="/" class="navigation-links" id="home-button">
				<div id="home-accent"></div>
				<div id="home-text">
					<h1>Micah Kacmarynski</h1>
				</div>
			</a>
			<div id="page-links">
